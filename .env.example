BASIC_AUTH_USER=phala
BASIC_AUTH_PASSWORD_SHA256=replace-with-sha256-password-hash
REDPILL_API_URL=https://service.redpill.ai
REDPILL_API_KEY=replace-with-redpill-admin-key
PRIVATE_AI_CONTROL_URL=https://control.redpill.ai
REDPILL_WEB_URL=https://redpill.ai
REDPILL_WEB_REVALIDATE_TOKEN=replace-with-web-revalidate-token
REDPILL_REQUEST_TIMEOUT_MS=15000
REDPILL_SYNC_AFTER_WRITE=true
REDPILL_MODEL_CACHE_TTL_MS=300000
REDPILL_DEPLOYMENT_CACHE_TTL_MS=300000
REDPILL_PHALA_PROVIDERS=phala
REDPILL_PHALA_HOST_SUFFIXES=phala.com
PIG_ADMIN_TOKEN=replace-with-pig-bearer-token
PIG_REQUEST_TIMEOUT_MS=2500
PIG_METRICS_PATH=/pig/metrics
PIG_POLICY_PATH=/admin/v1/predictive-policy
PIG_METRICS_CACHE_TTL_MS=1200
PIG_METRICS_STALE_TTL_MS=60000

# Optional exact HTTPS origin -> node TOKEN JSON, mounted read-only with mode 0600.
PIG_NODE_TOKENS_FILE=
